{
  "name": "@acme/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./src/client.ts"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./src/schema.ts"
    },
    "./auth-schema": {
      "types": "./dist/auth-schema.d.ts",
      "default": "./src/auth-schema.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev": "bun run --watch tsc",
    "lint": "echo \"No lint config\"",
    "format": "echo \"Using biome in root\"",
    "db:generate": "bun with-env drizzle-kit generate",
    "db:push": "bun with-env drizzle-kit push",
    "db:reset": "bun with-env ./reset-db.ts",
    "db:seed": "bun with-env ./src/seed.ts",
    "db:studio": "bun with-env drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo node_modules dist",
    "with-env": "bun --env-file=../../.env --"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "catalog:",
    "postgres": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@acme/tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:"
  }
}
