{
  "name": "@acme/ui",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./button": "./src/button.tsx",
    "./dropdown-menu": "./src/dropdown-menu.tsx",
    "./field": "./src/field.tsx",
    "./input": "./src/input.tsx",
    "./label": "./src/label.tsx",
    "./separator": "./src/separator.tsx",
    "./theme": "./src/theme.tsx",
    "./toast": "./src/toast.tsx"
  },
  "license": "MIT",
  "scripts": {
    "dev": "bun run --watch tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo node_modules dist",
    "fixall": "biome check --write --diagnostic-level=error .",
    "lint": "biome lint --write --diagnostic-level=error .",
    "format": "biome format --write --diagnostic-level=error .",
    "ui-add": "bunx shadcn@latest add"
  },
  "dependencies": {
    "@radix-ui/react-icons": "catalog:react",
    "class-variance-authority": "catalog:react",
    "radix-ui": "catalog:react",
    "sonner": "catalog:react",
    "tailwind-merge": "catalog:react"
  },
  "devDependencies": {
    "@acme/tsconfig": "workspace:*",
    "@types/react": "catalog:react",
    "react": "catalog:react",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:react"
  }
}
