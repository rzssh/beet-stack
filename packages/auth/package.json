{
  "name": "@acme/auth",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./types": "./src/types.ts"
  },
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf .cache .turbo dist node_modules",
    "lint": "echo \"No lint config\"",
    "format": "echo \"Using biome in root\"",
    "generate": "bun with-env bunx @better-auth/cli generate --config script/auth-cli.ts --output ../db/src/auth-schema.ts",
    "typecheck": "tsc --noEmit",
    "with-env": "bun --env-file=../../.env --"
  },
  "dependencies": {
    "@acme/db": "workspace:*",
    "better-auth": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@better-auth/expo": "catalog:"
  },
  "peerDependenciesMeta": {
    "@better-auth/expo": {
      "optional": true
    }
  },
  "devDependencies": {
    "@acme/tsconfig": "workspace:*",
    "@better-auth/cli": "catalog:",
    "typescript": "catalog:"
  }
}
