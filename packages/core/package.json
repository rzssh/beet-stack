{
  "name": "@acme/core",
  "private": true,
  "type": "module",
  "exports": {
    "./contracts": {
      "types": "./src/contracts/index.ts",
      "default": "./src/contracts/index.ts"
    },
    "./env": { "types": "./src/env.ts", "default": "./src/env.ts" },
    "./auth": { "types": "./src/auth.ts", "default": "./src/auth.ts" },
    "./server": {
      "types": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo node_modules dist",
    "fixall": "biome check --write --diagnostic-level=error .",
    "lint": "biome lint --write --diagnostic-level=error .",
    "format": "biome format --write --diagnostic-level=error ."
  },
  "dependencies": {
    "@acme/db": "workspace:*",
    "@better-auth/expo": "catalog:",
    "@elysiajs/cors": "catalog:",
    "@t3-oss/env-core": "catalog:",
    "better-auth": "catalog:",
    "elysia": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@acme/tsconfig": "workspace:*",
    "typescript": "catalog:"
  }
}
