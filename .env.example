NODE_ENV=development

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/messages
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

APP_URL=http://localhost:3000
MICROSERVICE_URL=http://localhost:3001
PORT=3000
SERVICE_PORT=3001
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,beet-stack://

# Set this only when Expo cannot discover the machine running the API.
# Use a LAN address reachable from the device, never a secret-bearing URL.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3001
