# Environment
NODE_ENV=development

# Server Ports
PORT=3000              # Main web app port (TanStack Start with integrated API)
SERVICE_PORT=3001      # Standalone microservice port (WebSockets, background jobs, etc.)
DATABASE_URL=postgres://postgres:postgres@localhost:5555/saas
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,expo://,exp://,http://192.168.*:*,http://10.0.*:*

# Inter-service Communication URLs
APP_URL=http://localhost:3000
MICROSERVICE_URL=http://localhost:3001

# OAuth Production URL (for oAuthProxy plugin)
# Set this to your PRODUCTION URL in development so OAuth callbacks work
# In production, can be omitted (auto-detected from platform vars or uses APP_URL)
BETTER_AUTH_URL=https://acmeweb-production.up.railway.app

# Mobile App (Expo) - Leave unset for development (auto-detects local IP)
# EXPO_PUBLIC_APP_URL=https://acmeweb-production.up.railway.app

