  },
  "catalog": {
    "@better-auth/expo": "^1.6.26",
    "@biomejs/biome": "^2.5.7",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/eden": "^1.4.9",
    "@elysiajs/static": "^1.4.10",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@t3-oss/env-core": "^0.13.11",
    "@types/bun": "^1.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-react": "^5.2.0",
    "better-auth": "^1.6.26",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "elysia": "^1.4.29",
    "immer": "^10.2.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  }
}
