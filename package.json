{
  "name": "bleeding-edge-stack",
  "version": "0.0.1",
  "description": "Elysia Backend + React Native + TanStack Start + Bun Monorepo",
  "private": true,
  "packageManager": "bun@1.3.2",
  "scripts": {
    "build": "bun run --filter=* build",
    "dev": "bun run --filter=* dev",
    "dev:web": "bun run --filter=@acme/web --filter=@acme/server dev",
    "typecheck": "bun run --filter=* typecheck",
    "fixall": "biome check --write --diagnostic-level=error .",
    "lint": "biome lint --write --diagnostic-level=error .",
    "format": "biome format --write --diagnostic-level=error .",
    "lint:ws": "bunx sherif@latest",
    "postinstall": "bun lint:ws",
    "db:generate": "bun run --filter=@acme/db db:generate",
    "db:migrate": "bun run --filter=@acme/db db:migrate",
    "db:push": "bun run --filter=@acme/db db:push",
    "db:reset": "bun run --filter=@acme/db db:reset",
    "db:seed": "bun run --filter=@acme/db db:seed",
    "db:studio": "bun run --filter=@acme/db db:studio",
    "clean": "bun run --filter=* clean && rm -rf node_modules",
    "update-deps": "bun run scripts/update-deps.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.7",
    "@types/bun": "^1.3.3"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@prisma/client",
    "@prisma/engines",
    "better-sqlite3",
    "core-js",
    "esbuild",
    "prisma",
    "protobufjs",
    "sharp"
  ],
  "workspaces": ["apps/*", "packages/*", "tooling/*"],
  "overrides": {
    "lightningcss": "1.30.1",
    "@sinclair/typebox": "0.34.41"
  },
