{
  "name": "beet-stack",
  "version": "0.0.1",
  "description": "BEET Stack: Bun, Elysia, Expo, and TanStack Start with Better Auth, Drizzle, and PostgreSQL",
  "license": "MIT",
  "author": "Sasha Mysak",
  "private": true,
  "packageManager": "bun@1.3.13",
  "scripts": {
    "build": "bun run --filter=* build",
    "check": "bun run check:vite && bun run typecheck && biome check . --diagnostic-level=error",
    "check:vite": "bun scripts/check-vite-instance.mjs",
    "test": "DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/messages AUTH_SECRET=local-test-secret-with-at-least-32-characters bun test packages/core/src/server/routers/messages/messages.test.ts",
    "test:integration": "bun test apps/server/src/app.integration.test.ts",
    "dev": "bun run --filter=* dev",
    "dev:web": "bun run --filter=@beet/web --filter=@beet/server dev",
    "typecheck": "bun run --filter=* typecheck",
    "fixall": "biome check --write --diagnostic-level=error .",
    "lint": "biome lint --write --diagnostic-level=error .",
    "format": "biome format --write --diagnostic-level=error .",
    "lint:ws": "bunx sherif@latest",
    "postinstall": "bun lint:ws",
    "db:generate": "bun run --filter=@beet/db db:generate",
    "db:migrate": "bun run --filter=@beet/db db:migrate",
    "db:push": "bun run --filter=@beet/db db:push",
    "db:seed": "bun run --filter=@beet/server db:seed",
    "db:studio": "bun run --filter=@beet/db db:studio",
    "clean": "bun run --filter=* clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/bun": "^1.3.14"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@prisma/client",
    "@prisma/engines",
    "better-sqlite3",
    "core-js",
    "esbuild",
    "prisma",
    "protobufjs",
    "sharp"
  ],
  "overrides": {
    "lightningcss": "1.32.0"
  },
  "workspaces": ["apps/*", "packages/*", "tooling/*"],
  "catalogs": {
    "react": {
      "@hookform/resolvers": "^5.2.2",
      "@radix-ui/react-label": "^2.1.8",
      "@radix-ui/react-slot": "^1.2.4",
      "@tailwindcss/postcss": "^4.3.3",
      "@tailwindcss/vite": "^4.3.3",
      "@tanstack/react-query": "^5.101.4",
      "@tanstack/react-router": "^1.170.25",
      "@tanstack/react-router-ssr-query": "^1.167.1",
      "@tanstack/react-start": "^1.168.42",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.4",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "lucide-react": "^0.554.0",
      "react": "19.2.0",
      "react-dom": "19.2.0",
      "react-hook-form": "^7.66.1",
      "tailwind-merge": "^3.6.0",
      "tailwindcss": "^4.3.3"
    }
  },
  "catalog": {
    "@better-auth/expo": "^1.6.26",
    "@biomejs/biome": "^2.5.7",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/eden": "^1.4.9",
    "@elysiajs/static": "^1.4.10",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@t3-oss/env-core": "^0.13.11",
    "@types/bun": "^1.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-react": "^5.2.0",
    "better-auth": "^1.6.26",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "immer": "^10.2.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  }
}
