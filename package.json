{
  "name": "bleeding-edge-stack",
  "version": "0.0.1",
  "description": "Elysia Backend + React Native + TanStack Start + Bun Monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "react": "^19.2.0",
      "react-dom": "^19.2.0",
      "react-native": "~0.81.5",
      "@types/react": "^19.2.5",
      "@types/react-dom": "^19.2.3",
      "better-auth": "^1.3.34",
      "@better-auth/expo": "^1.3.34",
      "@better-auth/cli": "^1.3.34",
      "drizzle-orm": "^0.39.0",
      "drizzle-kit": "^0.30.0",
      "zod": "^4.1.12",
      "@tanstack/react-query": "^5.90.10",
      "@tanstack/react-router": "^1.136.8",
      "@tanstack/react-start": "^1.136.8",
      "elysia": "^1.4.16",
      "@elysiajs/eden": "^1.4.0",
      "@elysiajs/cors": "^1.4.0",
      "@elysiajs/swagger": "^1.3.1",
      "expo": "~54.0.20",
      "expo-router": "~6.0.13",
      "expo-constants": "~18.0.10",
      "expo-secure-store": "~15.0.7",
      "expo-web-browser": "~15.0.8",
      "tailwindcss": "^4.0.0",
      "nativewind": "5.0.0-preview.2",
      "typescript": "^5.7.2",
      "vite": "^6.0.0",
      "@types/node": "^24.10.1",
      "@types/bun": "^1.3.2"
    }
  },
  "packageManager": "bun@1.3.2",
  "scripts": {
    "build": "bun run --filter=* build",
    "dev": "bun run --filter=* dev",
    "dev:web": "bun run --filter=@acme/web --filter=@acme/server dev",
    "typecheck": "bun run --filter=* typecheck",
    "format": "bun run --filter=* format",
    "lint": "bun run --filter=* lint",
    "lint:ws": "bunx sherif@latest",
    "postinstall": "bun lint:ws",
    "db:generate": "bun run --filter=@acme/db db:generate",
    "db:push": "bun run --filter=@acme/db db:push",
    "db:reset": "bun run --filter=@acme/db db:reset",
    "db:seed": "bun run --filter=@acme/db db:seed",
    "db:studio": "bun run --filter=@acme/db db:studio",
    "clean": "bun run --filter=* clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.6",
    "@types/bun": "^1.3.2"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "esbuild",
    "protobufjs",
    "sharp"
  ]
}
