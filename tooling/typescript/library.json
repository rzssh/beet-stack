{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./base.json",
	"compilerOptions": {
		/** Override base config's noEmit */
		"noEmit": false,
		
		/** Library-specific overrides */
		"composite": true,
		"declaration": true,
		"declarationMap": true,
		"outDir": "dist",
		"rootDir": "src",
		
		/** Module resolution for libraries */
		"moduleResolution": "Bundler",
		"module": "ESNext",
		"target": "ES2022"
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "**/*.test.*", "**/*.spec.*"]
}