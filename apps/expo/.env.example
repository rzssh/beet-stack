# Google Maps API Configuration
# Get your API key from: https://console.cloud.google.com/apis/credentials
# See API_SETUP.md for detailed setup instructions
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Backend API URLs
# Update these based on your development environment
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_WS_URL=ws://localhost:3000

# Optional: Separate API keys for better cost tracking
# EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=your_places_api_key
# EXPO_PUBLIC_GOOGLE_DIRECTIONS_API_KEY=your_directions_api_key

# Optional: Environment identifier
# EXPO_PUBLIC_ENV=development
