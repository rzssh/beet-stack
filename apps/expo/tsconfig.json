{
  "extends": ["@acme/tsconfig/base.json"],
  "compilerOptions": {
    "jsx": "react-native",
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "moduleSuffixes": [".ios", ".android", ".native", ""],
    "paths": { "~/*": ["./src/*"] }
  },
  "include": [
    "src",
    "*.ts",
    "*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "react-native.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.flow.js",
    "**/node_modules/react-native/index.js"
  ]
}
