{
  "name": "@beet/expo",
  "private": true,
  "license": "MIT",
  "main": "index.ts",
  "scripts": {
    "clean": "rm -rf .cache .expo android ios node_modules",
    "dev": "expo start",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "fixall": "biome check --write --diagnostic-level=error .",
    "lint": "biome lint --write --diagnostic-level=error .",
    "format": "biome format --write --diagnostic-level=error .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@beet/core": "workspace:*",
    "@better-auth/expo": "catalog:",
    "@elysiajs/eden": "catalog:",
    "@tanstack/react-query": "catalog:react",
    "better-auth": "catalog:",
    "expo": "~55.0.0",
    "expo-constants": "~55.0.0",
    "expo-linking": "~55.0.16",
    "expo-network": "~55.0.0",
    "expo-router": "~55.0.0",
    "expo-secure-store": "~55.0.0",
    "expo-splash-screen": "~55.0.0",
    "expo-status-bar": "~55.0.0",
    "expo-web-browser": "~55.0.18",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-worklets": "~0.7.0"
  },
  "devDependencies": {
    "@beet/tsconfig": "workspace:*",
    "@types/react": "catalog:react",
    "elysia": "catalog:",
    "typescript": "catalog:"
  }
}
