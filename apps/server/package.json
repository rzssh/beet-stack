{
  "name": "@acme/server",
  "version": "0.0.0",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./src/app": {
      "types": "./dist/app.d.ts",
      "default": "./src/app.ts"
    }
  },
  "scripts": {
    "build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server ./src/index.ts",
    "build:types": "tsc",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "bun with-env --watch src/index.ts",
    "with-env": "bun --env-file=../../.env --bun",
    "lint:check": "biome check .",
    "lint": "biome check --write --diagnostic-level=error .",
    "lint:linter": "biome lint --write --diagnostic-level=error .",
    "lint:formatter": "biome format --write --diagnostic-level=error .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo node_modules dist"
  },
  "dependencies": {
    "@acme/config": "workspace:*",
    "@acme/db": "workspace:*",
    "@elysiajs/cors": "catalog:",
    "@elysiajs/opentelemetry": "catalog:",
    "@elysiajs/swagger": "catalog:",
    "@fontsource-variable/geist": "catalog:",
    "@fontsource-variable/geist-mono": "catalog:",
    "@sentry/bun": "catalog:",
    "elysia": "catalog:",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "postgres": "catalog:",
    "resend": "catalog:",
    "stripe": "catalog:"
  },
  "module": "src/index.ts",
  "devDependencies": {
    "@acme/tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
