{
  "name": "@acme/server",
  "version": "0.0.0",
  "main": "./src/server.ts",
  "types": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server ./src/server.ts",
    "build:types": "tsc",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "bun with-env --watch src/index.ts",
    "with-env": "bun --env-file=../../.env --bun",
    "lint:check": "biome check .",
    "lint": "biome check --write --diagnostic-level=error .",
    "lint:linter": "biome lint --write --diagnostic-level=error .",
    "lint:formatter": "biome format --write --diagnostic-level=error .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo node_modules dist"
  },
  "dependencies": {
    "@acme/db": "workspace:*",
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/opentelemetry": "^1.4.6",
    "@elysiajs/swagger": "^1.3.1",
    "@sentry/bun": "^10.25.0",
    "elysia": "^1.4.16",
    "postgres": "^3.4.7",
    "resend": "^6.4.2",
    "stripe": "^19.3.1"
  },
  "module": "src/index.ts",
  "devDependencies": {
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2"
  }
}
