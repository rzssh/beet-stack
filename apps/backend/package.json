{
  "name": "backend",
  "version": "0.0.0",
  "main": "./src/server.ts",
  "types": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server ./src/server.ts",
    "build:types": "tsc --project tsconfig.json",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "bun with-env --watch src/server.ts",
    "with-env": "bun --env-file=../../.env --bun",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo node_modules dist"
  },
  "dependencies": {
    "@acme/db": "workspace:*",
    "@acme/platform": "workspace:*",
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/opentelemetry": "^1.4.6",
    "@elysiajs/swagger": "^1.3.1",
    "elysia": "^1.4.16"
  },
  "devDependencies": {
    "@acme/eslint-config": "workspace:*",
    "@acme/prettier-config": "workspace:*",
    "bun-types": "^1.3.2"
  },
  "module": "src/index.ts"
}
