{
  "extends": "@acme/tsconfig/web.json",
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "composite": true,
    "noEmit": false,
    "outDir": "${configDir}/tsc-build",
    "baseUrl": ".",
    "paths": { "~/*": ["./src/*"] }
  },
  "references": [
    { "path": "../../apps/server" },
    { "path": "../../packages/core" }
  ]
}
