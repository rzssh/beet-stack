{
  "family": "elysia-better-auth-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::{ACCOUNT_ID}:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::{ACCOUNT_ID}:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "elysia-api",
      "image": "{ECR_REPOSITORY_URI}:latest",
      "portMappings": [{ "containerPort": 3001, "protocol": "tcp" }],
      "essential": true,
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "3001" }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:ssm:{REGION}:{ACCOUNT_ID}:parameter/elysia-api/database-url"
        },
        {
          "name": "AUTH_SECRET",
          "valueFrom": "arn:aws:ssm:{REGION}:{ACCOUNT_ID}:parameter/elysia-api/auth-secret"
        },
        {
          "name": "DISCORD_CLIENT_ID",
          "valueFrom": "arn:aws:ssm:{REGION}:{ACCOUNT_ID}:parameter/elysia-api/discord-client-id"
        },
        {
          "name": "DISCORD_CLIENT_SECRET",
          "valueFrom": "arn:aws:ssm:{REGION}:{ACCOUNT_ID}:parameter/elysia-api/discord-client-secret"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/elysia-better-auth-api",
          "awslogs-region": "{REGION}",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:3001/api/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}
