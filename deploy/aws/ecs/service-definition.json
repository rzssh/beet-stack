{
  "serviceName": "elysia-better-auth-api-service",
  "cluster": "elysia-cluster",
  "taskDefinition": "elysia-better-auth-api",
  "desiredCount": 2,
  "launchType": "FARGATE",
  "platformVersion": "LATEST",
  "networkConfiguration": {
    "awsvpcConfiguration": {
      "subnets": ["subnet-{SUBNET_ID_1}", "subnet-{SUBNET_ID_2}"],
      "securityGroups": ["sg-{SECURITY_GROUP_ID}"],
      "assignPublicIp": "ENABLED"
    }
  },
  "loadBalancers": [
    {
      "targetGroupArn": "arn:aws:elasticloadbalancing:{REGION}:{ACCOUNT_ID}:targetgroup/{TARGET_GROUP_NAME}/{TARGET_GROUP_ID}",
      "containerName": "elysia-api",
      "containerPort": 3001
    }
  ],
  "healthCheckGracePeriodSeconds": 60,
  "deploymentConfiguration": {
    "maximumPercent": 200,
    "minimumHealthyPercent": 50,
    "deploymentCircuitBreaker": { "enable": true, "rollback": true }
  },
  "enableExecuteCommand": true,
  "tags": [
    { "key": "Environment", "value": "production" },
    { "key": "Application", "value": "elysia-better-auth" }
  ]
}
