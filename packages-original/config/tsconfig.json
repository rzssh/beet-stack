{
  "extends": "@acme/tsconfig/library.json",
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": false,
    "paths": {
      "~/*": [
        "./src/*"
      ]
    }
  },
  "references": [
    {
      "path": "../../apps/server"
    }
  ]
}
